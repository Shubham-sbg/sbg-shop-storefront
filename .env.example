# SBG SHOP — Environment Configuration Example
# Copy this file to .env.local for local development

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Store Metadata
NEXT_PUBLIC_STORE_NAME="SBG SHOP"
NEXT_PUBLIC_STORE_REGION="IN"
NEXT_PUBLIC_CURRENCY="INR"

